// Authoring source embedded in M_WF2_Sand. World positions are centimeters.
// Approved direction: 03B Soft Erosion, broad feathered wear with restrained shallow grooves.
// Inputs: P, LightColor, DarkColor, MacroScale, DetailScale, GrainStrength,
// ArenaRadius, TrackWidth, TrackStrength, NormalStrength,
// TraceIrregularity, TraceBreakup, InnerWear, WearSoftness, GrooveStrength,
// WearMask (RGBA texture), WearMaskSpan (meters), MaskWeight.
// OUTPUT_MODE: 0 color, 1 world normal, 2 roughness.
struct SandField {
 float hash(float2 p) { return frac(sin(dot(p,float2(127.1,311.7)))*43758.5453); }
 float noise(float2 p) {
  float2 i=floor(p),f=frac(p);f=f*f*(3-2*f);
  return lerp(lerp(hash(i),hash(i+float2(1,0)),f.x),lerp(hash(i+float2(0,1)),hash(i+1),f.x),f.y);
 }
 float layers(float2 p) {return .57*noise(p)+.28*noise(p*2.03+17.1)+.15*noise(p*4.17-4.7);}
 float height(float2 p,float detail) {
  float n=noise(p*.48),a=n*3.7;
  float2 q=float2(cos(a)*p.x-sin(a)*p.y,sin(a)*p.x+cos(a)*p.y);
  float ripple=sin(q.x*9+noise(p*1.1)*3)*.5+.5;
  return .75*layers(p*detail)+.08*ripple*noise(p*.8+4)+.17*noise(p*71.7);
 }
 float3 sweep(float2 p,float radius,float center,float halfAngle,float width,float drift,float seed,float irregularity,float breakup,float softness) {
  float a=atan2(p.y,p.x);
  float along=atan2(sin(a-center),cos(a-center));
  float gate=1-smoothstep(halfAngle*.45,halfAngle,abs(along));
  float wave=(.30*sin(a*3+seed)+.14*sin(a*5-seed*1.7)+.08*sin(a*9+seed*.43))*irregularity;
  float target=radius+wave+drift*along/max(halfAngle,.1);
  float d=length(p)-target;
  float w=max(.04,width*(.62+.38*noise(float2(a*3.7+seed,seed)))*sqrt(gate));
  float edge=(layers(p*1.55+seed)-.5)*width*.34;
  float profile=exp2(-pow(abs((d+edge)/w),2)*lerp(3.6,1.7,saturate(softness)));
  // A coherent softly abraded surface, with fine grain rather than isolated stains.
  float stretched=layers(float2(a*radius*.48+seed,(d+noise(p*.9)*.08)*4.6+seed));
  float grains=noise(p*12.3+seed*.37);
  float rubbed=.66+stretched*.28+grains*.06;
  float patches=smoothstep(.18,.74,layers(p*.68+seed*1.9));
  float patchMask=lerp(1,.33+patches*.67,breakup);
  float stroke=profile*gate*rubbed*patchMask;
  // Sparse, short, off-center grooves sit within the wide wear. No continuous rake lines.
  float grainLine=noise(float2(a*radius*.43+seed,(d+noise(p*1.1)*.12)*8.4+seed));
  float grooves=smoothstep(.61,.80,grainLine)*smoothstep(.38,.70,noise(p*1.1+seed));
  grooves*=profile*gate;
  float lip=exp2(-pow(abs((d-w*.63+edge)/max(width*.28,.05)),2)*2.5)*gate;
  lip*=lerp(.18,.55,stretched)*patchMask;
  return float3(stroke,lip,grooves);
 }
 float3 wear(float2 p,float arena,float width,float irregularity,float breakup,float inner,float softness) {
  float r=arena-1.25;
  float3 mark=0;
  mark+=sweep(p,r-.50,2.30,1.02,width,.34,1.7,irregularity,breakup,softness)*.90;
  mark+=sweep(p,r-.70,-.85,1.00,width*1.18,-.30,8.3,irregularity,breakup,softness)*1.03;
  mark+=sweep(p,r+.10,.65,.58,width*.62,.35,16.2,irregularity,breakup,softness)*.50;
  mark+=sweep(p,r-1.25,-2.65,.56,width*.70,-.32,23.4,irregularity,breakup,softness)*.57;
  mark+=sweep(p,r-4.40,-2.00,.66,width*.58,.42,31.8,irregularity,breakup,softness)*inner*.68;
  mark+=sweep(p,r-3.20,.60,.46,width*.43,-.35,47.1,irregularity,breakup,softness)*inner*.43;
  mark+=sweep(p,r-6.00,2.50,.37,width*.35,.25,53.7,irregularity,breakup,softness)*inner*.18;
  // Fade at the original arena boundary; the center has no additional scatter layer.
  return saturate(mark)*(1-smoothstep(arena-.15,arena+.35,length(p)));
 }
};
SandField s;
float2 p=P.xy*.01;
float macro=s.layers(p*MacroScale);
float medium=s.layers(mul(float2x2(.81,-.59,.59,.81),p)*DetailScale+13.7);
float height=s.height(p,DetailScale);
float3 proceduralWear=s.wear(p,ArenaRadius,TrackWidth,TraceIrregularity,saturate(TraceBreakup),InnerWear,WearSoftness);
// Authored mask is north-up: Unreal +X points toward image top, +Y toward image right.
float2 wearUV=float2(p.y,-p.x)/max(WearMaskSpan*ArenaRadius/18.0,1.0)+.5;
float4 maskDetail=Texture2DSample(WearMask,WearMaskSampler,wearUV);
float4 maskSoft=Texture2DSampleLevel(WearMask,WearMaskSampler,wearUV,2.5);
float detailWear=maskDetail.r*maskDetail.a;
float softWear=maskSoft.r*maskSoft.a;
float regional=.20+.80*smoothstep(.02,.45,proceduralWear.x);
regional*=1-smoothstep(ArenaRadius-.15,ArenaRadius+.35,length(p));
float3 authoredWear=float3(detailWear*.65+softWear*.35,max(0,detailWear-softWear),max(0,softWear-detailWear)*3.0)*regional;
float3 worn=lerp(proceduralWear,authoredWear,saturate(MaskWeight))*TrackStrength;
float track=saturate(worn.x),lip=saturate(worn.y),grooves=saturate(worn.z)*GrooveStrength;
#if OUTPUT_MODE == 1
float aaNormal=1-saturate(length(fwidth(p))*14);
float relief=(height*1.25*aaNormal-track*.65+lip*.55-grooves*6.0)*NormalStrength;
float3 N=normalize(Parameters.TangentToWorld[2]);
float3 dx=ddx(P),dy=ddy(P),r1=cross(dy,N),r2=cross(N,dx);
float det=dot(dx,r1);
float3 gradient=(r1*ddx(relief)+r2*ddy(relief))*sign(det)/max(abs(det),1e-4);
return normalize(N-gradient);
#elif OUTPUT_MODE == 2
return clamp(.86+(medium-.5)*.11-track*.075+lip*.045-grooves*.02,.70,.96);
#else
float patch=saturate(.32+macro*.40+(medium-.5)*.16);
float3 color=lerp(DarkColor,LightColor,patch);
float grain=(s.noise(p*143.7)-.5)*GrainStrength;
float aa=1-saturate(length(fwidth(p))*36);
color*=1+grain*aa+(medium-.5)*.09;
color*=1-track*.40-grooves*.075;
color=lerp(color,color*float3(1.015,.985,.955),track);
return color+LightColor*lip*.065;
#endif
