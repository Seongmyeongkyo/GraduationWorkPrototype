# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Python caches generated by Blender scripts
__pycache__/
*.py[cod]

# Local agent instructions and authoring automation (not runtime game code)
/.local-work/
/.claude/settings.local.json
/AGENTS.md
/Scripts/LocalAutomation/
/Scripts/Blender/
/Scripts/CreateMainMenuMap.py
/Scripts/CreateRound01Map.py
/Scripts/CreateRound02Concepts.py
/Scripts/UpgradeRound01Art.py
/Scripts/UpgradeRound02Axes.py
/Scripts/VerifyRound01Map.py

# Local generated authoring/import verification reports; keep layout JSON tracked
/Art/Maps/*/*Verification.json
/Art/Maps/*/Validation.json
/Art/Maps/*/Unreal_Import_Report.json

# Legacy locations for local work notes (new notes belong in .local-work)
/Docs/WeeklyDevelopmentReview.md
/Docs/MainMenu.md
/Art/Maps/*/README.md

# Paused title/login background concepts (keep these drafts local)
/Art/UI/TitleScreen/CloseIN_TitleBackground_v1.png
/Art/UI/TitleScreen/CloseIN_TitleBackground_Forest_v1.png
/Art/UI/TitleScreen/CloseIN_TitleBackground_Forest_v2.png
/Art/UI/TitleScreen/CloseIN_TitleBackground_Forest_v3.png
/Art/UI/LoginScreen/CloseIN_LoginBackground_v1.png
